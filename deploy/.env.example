# Copy to deploy/.env on the VM and fill in. Never commit .env.
PUBLIC_URL=https://clickup.cissegypt.net

DB_NAME=TaskManagementDb
DB_USER=taskapp
DB_PASSWORD=change-me

# Generate: openssl rand -base64 48
JWT_KEY=change-me-long-random-string

# From IT (Cloudflare Zero Trust -> Tunnels). Only needed with --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
