{
  "name": "task-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @task/web",
    "build": "npm run build --workspace @task/web",
    "start": "npm run start --workspace @task/web",
    "lint": "npm run lint --workspace @task/web",
    "typecheck": "npm run typecheck --workspace @task/web",
    "mobile": "npm run start --workspace @task/mobile",
    "mobile:offline": "npm run start:offline --workspace @task/mobile",
    "mobile:android": "npm run android --workspace @task/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @task/mobile"
  }
}
